@article{lindh_bringing_2023,
  title = {Bringing the Market in: An Expanded Framework for Understanding Popular Responses to Economic Inequality},
  shorttitle = {Bringing the Market In},
  author = {Lindh, Arvid and McCall, Leslie},
  year = 2023,
