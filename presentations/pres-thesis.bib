}

@article{liu_does_2026,
  title = {Does Education Legitimise Inequality? Comparative Analysis of Income Inequality, Education, and Meritocratic Beliefs},
  shorttitle = {Does Education Legitimise Inequality?},
  author = {Liu, Cheng and Wang, Jingjing},
  year = 2026,
