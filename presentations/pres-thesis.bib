@article{kluegel_legitimation_1999,
  title = {The Legitimation of Capitalism in the Postcommunist Transition Public Opinion about Market Justice, 1991—1996},
  author = {Kluegel, James R. and Mason, David S. and Wegener, Bernd},
  year = 1999,
  month = sep,
  journal = {European Sociological Review},
  volume = {15},
  number = {3},
  pages = {251--283},
  issn = {0266-7215},
  doi = {10.1093/oxfordjournals.esr.a018263},
  urldate = {2025-11-11},
  abstract = {This paper examines change in economic justice attitudes in five former communist states (Bulgaria, the Czech Republic, eastern Germany, Hungary, and Russia), using data from opinion surveys conducted in 1991 and 1996. We examine the implications of theory and research concerning the popular legitimation of western capitalism for change in support for ‘market justice’ beliefs and norms among postcommunist publics. Our analyses show: first, that in the Czech Republic and eastern Germany, public opinion is moving closer to market justice as found in western capitalism, but socialist justice remains strong or is increasing in the other three countries; secondly, that in postcommunist countries correlations between support for market justice norms and the perceived fairness of the existing economic order have become stronger over time; and thirdly, that privatesector employment, and retrospective, current and prospective standard-of-living evaluations each shape market justice beliefs and norms. We conclude that (1) theory of the public legitimation of capitalism in the West does apply in postcommunist states; (2) change in market/socialist justice is a function of both collective and individual level factors; and (3) we have entered a second stage of the transition where popular economic justice evaluations are more clearly subject to ‘empirical test’.},
  file = {/home/tomasurzua/snap/zotero-snap/common/Zotero/storage/AUJSNTGI/Kluegel et al. - 1999 - The Legitimation of Capitalism in the Postcommunist Transition Public Opinion about Market Justice,.pdf;/home/tomasurzua/snap/zotero-snap/common/Zotero/storage/N643PTEJ/oxfordjournals.esr.html}
}

@article{koos_moral_2019,
  title = {The Moral Economies of Market Societies: Popular Attitudes towards Market Competition, Redistribution and Reciprocity in Comparative Perspective},
  shorttitle = {The Moral Economies of Market Societies},
  author = {Koos, Sebastian and Sachweh, Patrick},
  year = 2019,
